APP_ENV=dev
MODEL_MODE=mock
DATABASE_URL=postgresql+psycopg://learning:local-dev-database-only@127.0.0.1:55432/learning
SECRET_KEY=local-development-only-change-this-secret-5703
STORAGE_ROOT=./artifacts/storage
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_PROVIDER=mock
LLM_MODEL=authored-extractive-v1
LLM_API_BASE=
LLM_API_KEY=
# Admin > Models supports saved, tested and activated provider configurations.
# API and worker must share the same persistent encryption key file.
# Development creates a restricted local file when the first credential is saved.
# Production requires a pre-provisioned Fernet key (file or environment variable).
MODEL_CONFIG_KEY_FILE=./.secrets/model-config.key
MODEL_CONFIG_ENCRYPTION_KEY=
TIKTOKEN_CACHE_DIR=./artifacts/tiktoken
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=intfloat/e5-small-v2
EMBEDDING_REVISION=main
EMBEDDING_DIMENSION=384
LOCAL_MODEL_DEVICE=auto
CHAT_RELEVANCE_GATE=true
CHAT_RETRIEVAL_CACHE=true
# Source-relation checker candidates v1/v2 remain off until separately validated.
CHAT_SOURCE_RELATION_POLICY=off
# Auxiliary unit-definition lookup remains opt-in; semantic support checks are unchanged.
CHAT_COVERAGE_QUERY_POLICY=off
# The compact checker is opt-in; its real quality calibration remains separate.
CHAT_JOINT_CHECKER_POLICY=typed_joint_v5
# New chat requests freeze strict answer/refusal field examples; old commands retain strict_v1.
CHAT_PROVIDER_OUTPUT_POLICY=json_field_contract_v2
# Freeze verified raw definition boundaries for new chat; old commands retain legacy source blocks.
CHAT_SOURCE_BLOCK_POLICY=raw_definition_block_partition_v2
# scoped_compact_v7 adds lossless input references and semantic repair routing.
# V5 stays the default; V6 and V7 require separate real-output quality review.
# Server-owned official visual reviewer bundles, selected by safe directory name.
VISUAL_CATALOG_STAGING_ROOT=./artifacts/visual-catalog-staging
CHAT_QUERY_PREPARATION_POLICY=anchored_reference_v22
# Optional calibrated semantic-memory policy JSON; unset retains rule selection.
MEMORY_SEMANTIC_POLICY_FILE=
MAX_UPLOAD_BYTES=536870912
PARSER_WALL_SECONDS=900
PARSER_OUTPUT_MAX_BYTES=268435456
MAX_PROVIDER_CALLS=4
PROVIDER_TIMEOUT_SECONDS=60
REQUEST_TIMEOUT_SECONDS=180
