+def _selection_index(context):
+    """Index immutable input domains and existing required keys, never judgments."""
+    packet, claims, _, fragments = _tables(context)
+    catalogue, _ = _quote_catalogue(packet)
+    schema = wire_schema(context)
+    definitions = schema["$defs"]
+    claim_keys = {}
+    for branch in schema["properties"]["cs"]["items"]["anyOf"]:
+        definition = definitions[branch["$ref"].split("/")[-1]]
+        basis = definition["properties"]["b"]
+        labels = [basis["const"]] if "const" in basis else basis["enum"]
+        for label in labels:
+            claim_keys[label] = list(definition["required"])
+    by_claim = {row["claim_id"]: row for row in packet["SOURCE_SYNTACTIC_UNITS"]}
+    bindings = {row["claim_id"]: row for row in packet["ACTUAL_CITATION_BINDINGS"]}
+    quotes = {fid: [] for fid in fragments}
+    for quote_id, reference in catalogue.items():
+        quotes[reference["fragment_id"]].append(quote_id)
+    return {
+        "input_only": True,
+        "root_required_short_keys": list(schema["required"]),
+        "claim_required_short_keys_by_basis": claim_keys,
+        "record_required_short_keys": {
+            name: list(definition["required"])
+            for name, definition in definitions.items()
+            if definition.get("type") == "object"
+        },
+        "parent_scopes_by_C": {
+            alias: {
+                "actual_unit_ids": [unit["unit_id"] for unit in by_claim[cid]["units"]],
+                "own_source_domains": {
+                    row["evidence_id"]: list(row["allowed_fragment_ids"])
+                    for row in bindings[cid]["citations"]
+                },
+            }
+            for alias, cid in claims.items()
+        },
+        "valid_quote_ids_by_fragment": quotes,
+    }
+
