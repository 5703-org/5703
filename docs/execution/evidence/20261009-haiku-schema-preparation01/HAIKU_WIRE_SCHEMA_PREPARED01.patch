+SCHEMA_TRANSPORT_ANTHROPIC_BOUNDS_V1 = "anthropic_structured_bounds_v1"
+
+
+def _schema_digest(schema):
+    return hashlib.sha256(
+        json.dumps(schema, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    ).hexdigest()
+
+
+def _anthropic_schema_projection(schema):
+    """Copy schema nodes only; local validators keep every original constraint."""
+    removed_count = 0
+    unsupported = {
+        "minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum", "multipleOf",
+        "minLength", "maxLength", "maxItems",
+    }
+    mappings = {"properties", "$defs", "definitions", "patternProperties", "dependentSchemas"}
+    sequences = {"allOf", "anyOf", "oneOf", "prefixItems"}
+    singles = {
+        "items", "contains", "not", "if", "then", "else", "propertyNames",
+        "additionalProperties", "unevaluatedProperties", "unevaluatedItems", "contentSchema",
+    }
+
+    def visit(node):
+        nonlocal removed_count
+        if not isinstance(node, dict):
+            return copy.deepcopy(node)
+        projected = copy.deepcopy(node)
+        removed = {}
+        for keyword in unsupported | {"minItems"}:
+            if keyword not in node:
+                continue
+            if keyword == "minItems" and type(node[keyword]) is int and node[keyword] in (0, 1):
+                continue
+            removed[keyword] = projected.pop(keyword)
+            removed_count += 1
+        if removed:
+            annotation = "Local validation constraints: " + "; ".join(
+                f"{keyword}={json.dumps(value, ensure_ascii=False, separators=(',', ':'))}"
+                for keyword, value in sorted(removed.items())
+            ) + "."
+            prior = projected.get("description", "")
+            projected["description"] = (prior + "\n" if prior else "") + annotation
+        for keyword in mappings:
+            children = node.get(keyword)
+            if isinstance(children, dict):
+                projected[keyword] = {name: visit(child) for name, child in children.items()}
+        for keyword in sequences:
+            children = node.get(keyword)
+            if isinstance(children, list):
+                projected[keyword] = [visit(child) for child in children]
+        for keyword in singles:
+            child = node.get(keyword)
+            if isinstance(child, dict):
+                projected[keyword] = visit(child)
+            elif keyword == "items" and isinstance(child, list):
+                projected[keyword] = [visit(item) for item in child]
+        return projected
+
+    return visit(schema), removed_count
+
+
+def prepare_schema_wire(config, request_body, original_schema):
+    """Apply the explicit Haiku wire policy without mutating its local contract.
+
+    Only JSON Schema bounds documented as unsupported by Anthropic are projected.
+    This compatibility policy does not establish the cause of any HTTP failure.
+    """
+    route = resolve(config)
+    if route is None or route.schema_transport is None:
+        return request_body, {}
+    if route.schema_transport != SCHEMA_TRANSPORT_ANTHROPIC_BOUNDS_V1:
+        raise ValueError("Unsupported route schema transport policy")
+    response_format = request_body.get("response_format")
+    if not isinstance(response_format, dict) or response_format.get("type") != "json_schema":
+        return request_body, {}
+    contract = response_format.get("json_schema")
+    provider_schema = contract.get("schema") if isinstance(contract, dict) else None
+    if not isinstance(provider_schema, dict) or not isinstance(original_schema, dict):
+        raise ValueError("Structured response schema must be an object")
+    projected, removed_count = _anthropic_schema_projection(provider_schema)
+    wire = copy.deepcopy(request_body)
+    wire["response_format"]["json_schema"]["schema"] = projected
+    return wire, {
+        "policy_id": route.schema_transport,
+        "original_response_schema_sha256": _schema_digest(original_schema),
+        "provider_schema_before_projection_sha256": _schema_digest(provider_schema),
+        "wire_schema_sha256": _schema_digest(projected),
+        "removed_bound_count": removed_count,
+    }
