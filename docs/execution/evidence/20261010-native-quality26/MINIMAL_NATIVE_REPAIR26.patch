+        return revised
+    reasons = {
+        "UNRESOLVED_TECHNICAL_ENTITY_COLLISION": "Selected support lacks this identifier; recheck the same-slot source witness. No alias or entailment is certified.",
+    }
+    revised["structural_issues"] = [
+        {**issue, "reason": reasons[issue["code"]]}
+        if isinstance(issue, dict) and issue.get("code") in reasons else issue
+        for issue in feedback["structural_issues"]
+    ]
+    return revised
+
