  "protected_claims_under_actual_judgment": [
    {
      "claim_id": "claim_843e45c501deb6048e9271db_1",
      "answer_field": "answer_text",
      "start": 145,
      "end": 349,
      "text": "The overall purpose of the light-dependent reactions is to convert light energy into chemical energy, and this chemical energy is used by the Calvin cycle to fuel the assembly of sugar molecules [ev_008].",
      "evidence_ids": [
        "ev_008"
      ]
    },
    {
      "claim_id": "claim_1c71ec2df3c08732f8f68cd7_1",
      "answer_field": "answer_text",
      "start": 552,
      "end": 758,
      "text": "Specifically, light-dependent reactions harness energy from the sun to produce ATP and NADPH, and these energy-carrying molecules travel into the stroma where the Calvin cycle reactions take place [ev_007].",
      "evidence_ids": [
        "ev_007"
      ]
    },
    {
      "claim_id": "claim_8cd7b13097db1301a18c28c6_1",
      "answer_field": "answer_text",
      "start": 759,
      "end": 1025,
      "text": "The carriers that move energy from the light-dependent reactions to the Calvin cycle are described as \"full\" because they bring energy; after the energy is released, the \"empty\" carriers return to the light-dependent reactions to obtain more energy [ev_001][ev_005].",
      "evidence_ids": [
        "ev_001",
        "ev_005"
      ]
    },
    {
      "claim_id": "claim_2e2e3ba2b43cbd571afa271b_1",
      "answer_field": "answer_text",
      "start": 1026,
      "end": 1189,
      "text": "Once in the stroma, the Calvin cycle uses the energy in ATP and NADPH to convert the three-carbon molecules into G3P, which builds carbohydrate molecules [ev_010].",
      "evidence_ids": [
        "ev_010"
      ]
    },
    {
      "claim_id": "claim_a6a2652d20ee17bbe5f3e20d_1",
      "answer_field": "short_answer",
      "start": 0,
      "end": 138,
      "text": "Light-dependent reactions store light energy in ATP and NADPH, which carry that energy into the stroma to power the Calvin cycle [ev_007].",
      "evidence_ids": [
        "ev_007"
      ]
    }
  ],
  "diagnostics_do_not_certify_entailment": true
