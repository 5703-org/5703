# Copy to .env and adjust. Never commit a real .env.
ENV=dev
DATABASE_URL=sqlite:///./dev.db
# Docker/Postgres example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/learning_assistant
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FEATURE_FLAGS=multi_workspace:false,lms_sync:false,agent_tools:false
SEED_DEMO_USERS=true
