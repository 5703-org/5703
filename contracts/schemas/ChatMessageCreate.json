{
  "$defs": {
    "ReadingContext": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "chapter",
            "textbook",
            "all"
          ],
          "title": "Scope",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "source_unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Unit Id"
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadingSelection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "scope"
      ],
      "title": "ReadingContext",
      "type": "object"
    },
    "ReadingSelection": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "title": "ReadingSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Content",
      "type": "string"
    },
    "use_profile": {
      "default": true,
      "title": "Use Profile",
      "type": "boolean"
    },
    "answer_mode": {
      "default": "textbook",
      "enum": [
        "textbook",
        "general_knowledge"
      ],
      "title": "Answer Mode",
      "type": "string"
    },
    "teaching_mode": {
      "anyOf": [
        {
          "enum": [
            "direct",
            "hint"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Teaching Mode"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "task_action": {
      "default": "auto",
      "enum": [
        "auto",
        "new",
        "continue",
        "more_hint",
        "full_explanation"
      ],
      "title": "Task Action",
      "type": "string"
    },
    "task_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Version"
    },
    "pending_tutor_question_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pending Tutor Question Id"
    },
    "pending_tutor_question_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pending Tutor Question Version"
    },
    "turn_role": {
      "default": "auto",
      "enum": [
        "auto",
        "learner_attempt"
      ],
      "title": "Turn Role",
      "type": "string"
    },
    "reading_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReadingContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "content"
  ],
  "title": "ChatMessageCreate",
  "type": "object"
}
